# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_PRIMARY_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_JUDGE_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_FALLBACK_TEMPERATURE=0.5
OPENROUTER_JUDGE_TEMPERATURE=0.1

# PostgreSQL — use localhost para dev local, postgres para Docker Compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_guardrails
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_guardrails

# Redis — use localhost para dev local, redis para Docker Compose
REDIS_URL=redis://localhost:6379/0

# Sessão
SESSION_TTL=86400
RETRIEVAL_LIMIT=5

# Frontend — use localhost para dev local, api para Docker Compose
VITE_API_BASE=http://localhost:8000
