# OpenRouter — primário do chat
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_PRIMARY_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_REASONING_ENABLED=true

# NVIDIA NIM — fallback de chat + embedding primário + judge
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_TEMPERATURE=0.5
NVIDIA_NIM_JUDGE_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_JUDGE_TEMPERATURE=0.1
NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_NIM_EMBEDDING_DIM=2048

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_guardrails
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag_guardrails

# Redis
REDIS_URL=redis://redis:6379/0

# Sessão
SESSION_TTL=86400
RETRIEVAL_LIMIT=5

# Frontend
VITE_API_BASE=http://localhost:8000

# Langfuse Cloud — Observabilidade de Traces e Guardrails
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
